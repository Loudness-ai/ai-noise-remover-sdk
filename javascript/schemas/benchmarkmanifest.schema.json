{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkManifest",
  "$ref": "#/$defs/BenchmarkManifest",
  "$defs": {
    "BenchmarkManifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BenchmarkFixture"
          }
        },
        "processors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Processor"
          }
        },
        "repetitions": {
          "type": "number"
        },
        "warmup": {
          "type": "number"
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/Policy"
            }
          ]
        },
        "comparison": {
          "anyOf": [
            {
              "const": false,
              "type": "boolean"
            },
            {
              "const": true,
              "type": "boolean"
            }
          ]
        },
        "expectations": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "durationToleranceSeconds": {
                  "anyOf": [
                    {
                      "type": "number"
                    }
                  ]
                },
                "allowDurationChange": {
                  "anyOf": [
                    {
                      "const": false,
                      "type": "boolean"
                    },
                    {
                      "const": true,
                      "type": "boolean"
                    }
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "fixtures",
        "processors",
        "repetitions",
        "warmup"
      ],
      "additionalProperties": false
    },
    "BenchmarkFixture": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "license"
      ],
      "additionalProperties": false
    },
    "Processor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        },
        "settings": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "const": false,
                "type": "boolean"
              },
              {
                "const": true,
                "type": "boolean"
              }
            ]
          }
        }
      },
      "required": [
        "name",
        "executable",
        "args",
        "version",
        "settings"
      ],
      "additionalProperties": false
    },
    "Policy": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NumericRule"
          }
        },
        "codecs": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "containers": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "unavailable": {
          "anyOf": [
            {
              "const": "warning",
              "type": "string"
            },
            {
              "const": "fail",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "rules"
      ],
      "additionalProperties": false
    },
    "NumericRule": {
      "type": "object",
      "properties": {
        "metric": {
          "anyOf": [
            {
              "const": "durationSeconds",
              "type": "string"
            },
            {
              "const": "sizeBytes",
              "type": "string"
            },
            {
              "const": "channels",
              "type": "string"
            },
            {
              "const": "sampleRate",
              "type": "string"
            },
            {
              "const": "integratedLufs",
              "type": "string"
            },
            {
              "const": "truePeakDbtp",
              "type": "string"
            },
            {
              "const": "samplePeakDbfs",
              "type": "string"
            },
            {
              "const": "rmsDbfs",
              "type": "string"
            },
            {
              "const": "nearFullScaleSamples",
              "type": "string"
            },
            {
              "const": "longestNearFullScaleRun",
              "type": "string"
            },
            {
              "const": "maxAbsDcOffset",
              "type": "string"
            },
            {
              "const": "silenceSeconds",
              "type": "string"
            },
            {
              "const": "leadingSilenceSeconds",
              "type": "string"
            },
            {
              "const": "trailingSilenceSeconds",
              "type": "string"
            },
            {
              "const": "channelImbalanceDb",
              "type": "string"
            }
          ]
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "severity": {
          "anyOf": [
            {
              "const": "warning",
              "type": "string"
            },
            {
              "const": "fail",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "metric"
      ],
      "additionalProperties": false
    }
  }
}
